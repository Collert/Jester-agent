# The dongle's agent: setup, pairing, the WebSocket to Pavilion, the TV's pages. Runs as root: it drives
# NetworkManager (nmcli), serves the setup page on port 80 and can reboot the Pi.
[Unit]
Description=Pavilion visual dongle agent
Wants=network.target NetworkManager.service
After=NetworkManager.service
# Crashing in a loop shouldn't stop it for good: keep trying.
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/usr/local/bin/jester-agent
Environment=JESTER_DB=/var/lib/jester/agent.db
# The kiosk browser (cog) runs as its own unit: it needs a login seat, and doesn't run as root. Its page goes to the
# screen by itself; the agent calls it back to its page and reloads it with jester-cogctl, and restarts the unit
# when that doesn't work, or to turn the picture.
# Quoted: unquoted, systemd splits it at the spaces and the command would be just the first word.
Environment="JESTER_BROWSER_OPEN=/usr/local/bin/jester-cogctl open"
Environment="JESTER_BROWSER_RELOAD=/usr/local/bin/jester-cogctl reload"
Environment="JESTER_BROWSER_RESTART=systemctl restart jester-kiosk.service"
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
