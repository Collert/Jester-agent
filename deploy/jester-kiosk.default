# Settings for the kiosk's browser (cog, started by /usr/local/bin/jester-kiosk). After a change:
#
#   sudo systemctl restart jester-kiosk
#   curl -s 127.0.0.1:8080/state       # "system": what the Pi has left

# The TV's picture. Empty: the TV's own preferred mode, at most JESTER_KIOSK_MODE_MAX (1920x1080 when empty).
# A smaller picture is less to draw: 1280x720 is under half the pixels of 1080p.
JESTER_KIOSK_MODE=
JESTER_KIOSK_MODE_MAX=

# 0: pages need a tap (a mouse click, a key) before they may play sound, as in an ordinary browser. Empty or 1: they
# may start it by themselves, which is what a TV nobody touches needs.
JESTER_KIOSK_AUTOPLAY=

# Extra flags for cog ("cog --help-all" lists them), e.g. --scale=0.8 to draw pages at four fifths of their size.
# (Not --web-mem-limit: WebKit counts only what a page has in memory, not what's swapped out, so on a dongle the
# limit never comes. The agent watches the swap instead.)
JESTER_COG_FLAGS=
