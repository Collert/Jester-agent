# Settings for the kiosk's browser (cog, started by /usr/local/bin/jester-kiosk). After a change:
#
#   sudo systemctl restart jester-kiosk
#   curl -s 127.0.0.1:8080/state       # "system": what the Pi has left

# The TV's picture. Empty: the TV's own preferred mode, at most JESTER_KIOSK_MODE_MAX (1920x1080 when empty).
# A smaller picture is less to draw: 1280x720 is under half the pixels of 1080p.
JESTER_KIOSK_MODE=
JESTER_KIOSK_MODE_MAX=

# Extra flags for cog ("cog --help-all" lists them), e.g. --web-mem-limit=250 to have the page's process start
# afresh when it grows past 250 MB.
JESTER_COG_FLAGS=
