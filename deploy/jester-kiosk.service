# The TV: cog (the WPE WebKit browser) on tty1, drawing straight onto the display, opening the agent's page. The
# launcher is deploy/jester-kiosk; its settings are in /etc/default/jester-kiosk.
#
# cog and not Chromium: on a Pi Zero 2 W (416 MB for everything) Chromium wanted about as much as there is for one
# page, and the dongle lived in swap. cog took about half as much in the same test, and nothing runs under it (no
# window system: it draws onto the display itself).
#
# systemd starts it again whenever it exits, always on the agent's page, which takes itself to the screen Pavilion
# picked. The agent calls it back to that page (jester-cogctl) and restarts this unit when that doesn't work.
[Unit]
Description=Pavilion visual dongle kiosk browser
After=systemd-user-sessions.service jester-agent.service plymouth-quit-wait.service
Wants=jester-agent.service
Conflicts=getty@tty1.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=kiosk
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
# What cog prints goes to the journal, not onto the TV's console.
StandardOutput=journal
StandardError=journal
TTYReset=yes
TTYVHangup=yes
UtmpIdentifier=tty1
UtmpMode=user
EnvironmentFile=-/etc/default/jester-kiosk
ExecStartPre=/bin/sh -c 'for i in $(seq 1 30); do curl -fsS -o /dev/null http://127.0.0.1:8080/state && exit 0; sleep 1; done; exit 0'
ExecStart=/usr/local/bin/jester-kiosk
Restart=always
RestartSec=2

[Install]
WantedBy=graphical.target
